{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLaMer workflow.json v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stages"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "readable": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "programs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/step"
          },
          {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/step"
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/stage"
        },
        {
          "$ref": "#/$defs/command"
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "command"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "driver",
        "model",
        "effort",
        "prompt",
        "timeout"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "driver": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "model": {
          "$ref": "#/$defs/text"
        },
        "effort": {
          "$ref": "#/$defs/text"
        },
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+(h|m|s))+$"
        },
        "schema": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
